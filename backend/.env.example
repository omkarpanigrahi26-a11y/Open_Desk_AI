PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=opendesk_db
DB_USER=root
DB_PASSWORD=your_password
DB_SYNC=false
NODE_ENV=development

# WhatsApp Remote Bridge
WHATSAPP_AUTHORIZED_NUMBER=919876543210
WHATSAPP_VERIFY_TOKEN=opendesk_verify_token

# File Indexer (optional comma-separated scan paths; defaults to ~/Projects, ~/Documents)
INDEX_PATHS=

# ==============================================================================
# AI Provider & Cloud LLM API Configuration
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLOUD_LLM_MODEL=gemini-1.5-flash
CLOUD_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Local Ollama Bridge (Tier 2 offline tasks)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
