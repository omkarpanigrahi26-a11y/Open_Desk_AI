{
  "name": "opendesk-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade Node.js + TypeScript backend for OpenDesk AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "opendesk",
    "express",
    "typescript",
    "websockets",
    "sequelize",
    "telemetry"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "get-windows": "^9.1.0",
    "mysql2": "^3.9.7",
    "sequelize": "^6.37.3",
    "systeminformation": "^5.22.6",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
